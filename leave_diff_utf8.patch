+    t = t.replaceAll(RegExp(r'[أإآ]'), 'ا'); // توحيد الألف
+    t = t.replaceAll('ة', 'ه'); // توحيد التاء المربوطة
+    t = t.replaceAll('ى', 'ي'); // توحيد الياء
+    t = t.replaceAll('ال', ''); // إزالة ال التعريف
+    t = t.replaceAll(RegExp(r'\s+'), ''); // إزالة المسافات
+    return t;
+  }
